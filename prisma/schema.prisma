generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id        Int      @id @default(autoincrement())
    nome      String
    email     String   @unique
    status    Boolean  @default(true)
    funcao    Funcao   @default(USER)
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt
    posts     Post[]

    @@map("users")
}

model Post {
    titulo    String
    subtitulo String?
    conteudo  String
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAd DateTime @default(now()) @updatedAt
    userId    Int
    autor     User     @relation(fields: [userId], references: [id])

    @@map("posts")
}

enum Funcao {
    ADMIN
    USER
}
